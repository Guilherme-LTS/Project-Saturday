{
  "expo": {
    "name": "Volleyball Draw",
    "slug": "volleyball-draw",
    "scheme": "volleyballdraw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/volleyball.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.volleyballdraw"
    },
    "android": {
      "package": "com.yourname.volleyballdraw",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#0D1117",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fa96bb1c-fd04-4daa-a150-70bc18d4a7de"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}