        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fa96bb1c-fd04-4daa-a150-70bc18d4a7de"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
